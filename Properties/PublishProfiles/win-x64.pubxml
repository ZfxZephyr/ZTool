<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained .exe to hand to someone on another machine.

    dotnet publish ZTool.csproj -c Release -p:PublishProfile=win-x64

  A profile rather than a command line so the release is reproducible, and so
  the RID stays off the everyday build: publish is the only thing that needs it.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Avalonia ships Skia and SQLite ships e_sqlite3, both native. Without
         this they land beside the exe and it is not one file any more. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- A 70MB exe to send around is rude. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Relative to the project directory, not this file. -->
    <PublishDir>publish\ZTool-v0.2.0-win-x64\</PublishDir>

    <!-- No symbols to hand out with a test build. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- The native packages drop their .pdb beside their .dll. The .dlls are
       already inside the exe; the symbols would only add 100MB to the folder
       someone is about to zip and send. -->
  <Target Name="DropSymbolsFromPublishFolder" AfterTargets="Publish">
    <ItemGroup>
      <_Symbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_Symbols)" />
  </Target>
</Project>
